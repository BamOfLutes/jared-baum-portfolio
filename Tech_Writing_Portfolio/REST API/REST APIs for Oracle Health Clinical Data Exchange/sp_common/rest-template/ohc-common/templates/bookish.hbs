	<header role="none">
		<div>
		<h1>{{{title}}}</h1>
		</div>
	</header>

	<main>
		<div>
      {{#if alertMsg}}<div class="preview-alert">{{{alertMsg}}}</div>{{/if}}
			<div class="ohc-grid">
				<div>
					<div class="ohc-menu-controls hidden-xs">
						<nav role="none">
							<div class="nav nav-pills nav-stacked" role="tablist">
								{{#if tabtoc}}
                <div class="ohc-menu-control-item active" role="none">
									<button type="button" href="#tab-toc" role="tab" aria-label="Table of Contents" aria-controls="tab-toc" aria-selected="true" class="opener" title="Table of Contents" data-toggle="tooltip" data-placement="right" >
										<span class="hidden-xs fa fa-list"></span>
										<span class="ohc-navpill">Table of Contents</span>
									</button>
								</div>
                {{/if}}
								{{#if tabsearch}}
								<div class="ohc-menu-control-item" role="none">
									<button type="button" href="#tab-search" role="tab" aria-label="Search options" aria-controls="tab-search" aria-selected="false" class="opener" title="Search" data-toggle="tooltip" data-placement="right" >
										<span class="hidden-xs fa fa-search"></span>
										<span class="ohc-navpill">Search</span>
									</button>
								</div>
								{{/if}}
								{{#if tabdownload}}
								<div class="ohc-menu-control-item" role="none">
									<button type="button" href="#tab-download" role="tab" aria-label="Download options" aria-controls="tab-download" aria-selected="false" class="opener" title="Download" data-toggle="tooltip" data-placement="right" >
										<span class="hidden-xs fa fa-download"></span>
										<span class="ohc-navpill">Download</span>
									</button>
								</div>
								{{/if}}
							</div>
						</nav>
					</div>

					<div role="navigation" class="ohc-menu hidden-xs hidden-print tab-content ">
            {{#if tabtoc}}
              {{#if_mt}}
                {{#if_is_learn}}
                  <p class="text-center learn-mt-banner"><b>{{i18n 'This page was machine translated.'}}</b></p>
                {{/if_is_learn}}
              {{/if_mt}}
						<div role="tabpanel" class="tab-pane fade active in" id="tab-toc">
							{{{tabtoc}}}
						</div>
            {{/if}}
						{{#if tabsearch}}
						<div role="tabpanel" class="tab-pane fade" id="tab-search">
							<h2>Search</h2>
							<form id="search-form" action="/apps/search/search.jsp" method="GET" target="_blank">
								<div class="form-group">
									<div class="input-group">
										<input type="text" name="q" class="form-control" id="search-query" aria-label="Search Query Field" placeholder="Search for...">
										<span class="input-group-btn">
											<button type="submit" class="btn btn-primary" aria-label="Submit Search Query">
												<span class="fa fa-search" aria-hidden="true"></span>
												<span class="sr-only">Search</span>
											</button>
										</span>
									</div>
								</div>
								{{#if book}}
								<div class="radio">
									<input type="radio" name="search-scope" id="search-scope-book" value="book">
									<label for="search-scope-book">Search this book</label>
								</div>
								{{/if}}
								{{#if product}}
								<div class="radio">
									<input type="radio" name="search-scope" id="search-scope-product" value="product">
									<label for="search-scope-product">Search this product</label>
								</div>
								{{/if}}
                {{#if category}}
								<div class="radio">
									<input type="radio" name="search-scope" id="search-scope-category" value="category">
									<label for="search-scope-category">Search this category</label>
								</div>
								{{/if}}
								<div class="radio">
									<input type="radio" name="search-scope" id="search-scope-all" value="all">
									<label for="search-scope-all">Search All Documentation</label>
								</div>
							</form>
						</div>
						{{/if}}
						{{#if tabdownload}}
						<div role="tabpanel" class="tab-pane fade" id="tab-download">
							<h2>Download</h2>
							{{#each tabdownload}}
								{{#if_eq type "application/pdf"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">PDF</a> for offline and print</p>{{/if_eq}}
								{{#if_eq type "application/x-mobipocket-ebook"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">Mobi</a> for Amazon Kindle</p>{{/if_eq}}
								{{#if_eq type "application/epub+zip"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">ePub</a> for most mobile devices</p>{{/if_eq}}
								{{#if_eq type "application/swagger+json"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">Swagger</a> for Swagger clients</p>{{/if_eq}}
								{{#if_eq type "application/json"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">JSON</a></p>{{/if_eq}}
								{{#if_eq type "application/xml"}}<p><a class="btn btn-primary" title={{title}} target="_blank" href="{{{href}}}" role="button">XML</a></p>{{/if_eq}}
							{{/each}}
						</div>
						{{/if}}
					</div>

					<article>{{{article}}}</article>

					<div><div><!-- resizable column --></div></div>
				</div>
			</div>
		</div>
	</main>


