<div class="book">
    {{#if html}}
        <a id="cat{{@../index}}book{{@index}}" href="{{html}}">{{title}}</a>{{#if pdf}} <a class="pdf-book-link" aria-label="PDF of {{title}}" href="{{pdf}}"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></a>{{/if}}
    {{else}}
        {{#if pdf}}
        <span id="cat{{@../index}}book{{@index}}">{{title}}</span>{{#if pdf}} <a class="pdf-book-link" aria-label="PDF of {{title}}" href="{{pdf}}"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></a>{{/if}}
        {{/if}}
    {{/if}}
    <div class="clearfix"></div>
</div>