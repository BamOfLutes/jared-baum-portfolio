<div class="widget-container" role="region" aria-label="Feedback">
  <button class="feedback-open" data-toggle="simple-collapsible" href="#feedback-controls" role="button" aria-expanded="false"
    aria-controls="feedback-controls" aria-label="{{i18n 'Feedback'}}">
  </button>
  <div class="collapse width" id="feedback-controls">
    <button class="feedback-close" type="button" aria-label="{{i18n 'Close feedback'}}"></button>
    <div>
      <span>{{i18n 'Was this page helpful?'}}</span>
      <div>{{i18n 'Tell us how to improve'}}</div>
    </div>
    <button class="thumbs down" value="No" aria-label="Send Negative Feedback"></button>
    <button class="thumbs up" value="Yes" aria-label="Send Positive Feedback"></button>
  </div>
</div>
