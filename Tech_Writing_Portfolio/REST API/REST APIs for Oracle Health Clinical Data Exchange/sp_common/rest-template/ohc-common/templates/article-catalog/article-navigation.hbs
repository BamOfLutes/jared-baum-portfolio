<div class="article-navigation">
  <div class="docs-sticky-top flex-column" role="navigation" aria-label="Table of contents and related articles">
    <div class="content-table flex-column">
      <p id="toc" class="docs-typography-body-sm docs-bold" role="heading" aria-level="2">In this article</p>
      <div id="art-toc" class="scrollable-content article-menu" aria-labelledby="toc">
        <ul class="no-bullets">
          {{#each innerArticles}}
          <li><span class="tocitem"><a class="docs-typography-body-sm" href="{{this.anchor}}">{{this.text}}</a></span></li>
          {{/each}}
        </ul>
      </div>
    </div>
    {{#if relatedArticles}}
    <div class="related-links">
      <p id="rel-articles" class="docs-typography-body-sm docs-bold" role="heading" aria-level="2">Related content</p>
      <ul class="no-bullets" aria-labelledby="rel-articles">
        {{#each relatedArticles}}
        <li><a class="docs-typography-body-sm" title="{{this.text}}" href="{{this.url}}" target="{{this.target}}">{{this.text}}</a></li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
  </div>
</div>